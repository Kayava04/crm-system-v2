# Copy to .env and fill in the values:  cp .env.example .env
# .env is git-ignored. Never commit real secrets.
# Read by docker-compose.yml.

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crm-db

# --- Seq (log viewer, UI on http://localhost:8081) ---
# Initial admin password, applied on the first start only.
SEQ_ADMIN_PASSWORD=change-me

# --- API (needed for `docker compose --profile app up`) ---
# At least 32 characters. Generate one with:  openssl rand -base64 48
JWT_SECRET_KEY=

# The system account created on the first start.
# The password needs upper and lower case letters, a digit and a symbol.
SUPERADMIN_EMAIL=admin@example.com
SUPERADMIN_PASSWORD=

# --- Optional ---
# Origin the browser opens the frontend from; only matters for direct,
# cross-origin calls to the API (CORS allow-list). Default: http://localhost:5173
# FRONTEND_ORIGIN=http://localhost:5173
