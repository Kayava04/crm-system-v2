{
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Default": ""
  },
  "Jwt": {
    "Issuer": "CrmSystem",
    "Audience": "CrmSystemClient",
    "ExpirationMinutes": 15,
    "SecretKey": ""
  },
  "Scheduling": { "TimeZone": "Europe/Kyiv" },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ]
  },
  "Notifications": {
    "Automation": {
      "Enabled": false,
      "IntervalSeconds": 900,
      "StartupDelaySeconds": 30,
      "LessonReminderHoursAhead": 24,
      "InvoiceReminderDaysBefore": 3,
      "IncludeOverdue": true,
      "MarkOverdueInvoices": true
    }
  },
  "RateLimiting": {
    "Auth": { "PermitLimit": 30, "WindowSeconds": 60 }
  },
  "Identity": {
    "Lockout": { "MaxAttempts": 5, "DurationMinutes": 15 }
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "SuperAdmin": {
    "Email": "",
    "Password": ""
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "Logs/crm-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": ["FromLogContext"]
  }
}
